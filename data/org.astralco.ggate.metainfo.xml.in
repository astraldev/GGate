<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-id">
  <id>@APP_ID@</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>GGate</name>
  <summary>Logic circuit simulator developed with GTK 4 and Python</summary>
  <description>
    <p>
      GGate is a user-friendly logic circuit simulator that lets you design,
      wire, and simulate digital logic circuits in real time.
    </p>
  </description>
  <launchable type="desktop-id">@APP_ID@.desktop</launchable>
  <developer_name>Koichi Akabe</developer_name>
  <url type="homepage">https://github.com/vbkaisetsu/ggate</url>
  <url type="bugtracker">https://github.com/vbkaisetsu/ggate/issues</url>
  <content_rating type="oars-1.1"/>
</component>
